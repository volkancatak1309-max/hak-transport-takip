NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SESSION_PASSWORD=at-least-32-characters-long-random-secret

# Telegram Bot (notifications)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=hak_transport_bildirim_bot
# Random secret used in the webhook URL (?secret=...) to reject foreign POSTs
TELEGRAM_WEBHOOK_SECRET=

# Public app URL used in Telegram "open panel" buttons (default: vercel.app)
NEXT_PUBLIC_APP_URL=https://hak-transport-takip.vercel.app

# Secret guarding the ghost-shift watchdog cron endpoint
# (/api/cron/shift-watchdog?secret=...). Set this on the external scheduler too.
CRON_SECRET=

# flespi GPS gateway (Teltonika FMC003) — SERVER-ONLY, asla NEXT_PUBLIC_ değil.
# REST token (Authorization: FlespiToken <token>) for pulling device messages.
FLESPI_TOKEN=
# Secret guarding the flespi sync endpoint (/api/flespi/sync?secret=...).
# Set this on the external scheduler too. May reuse CRON_SECRET's value.
FLESPI_SYNC_SECRET=
