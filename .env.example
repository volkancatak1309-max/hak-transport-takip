NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SESSION_PASSWORD=at-least-32-characters-long-random-secret

# Telegram Bot (notifications)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=hak_transport_bildirim_bot
# Random secret used in the webhook URL (?secret=...) to reject foreign POSTs
TELEGRAM_WEBHOOK_SECRET=

# Public app URL used in Telegram "open panel" buttons (default: vercel.app)
NEXT_PUBLIC_APP_URL=https://hak-transport-takip.vercel.app

# Secret guarding the ghost-shift watchdog cron endpoint
# (/api/cron/shift-watchdog?secret=...). Set this on the external scheduler too.
CRON_SECRET=

# flespi GPS gateway (Teltonika FMC003) — SERVER-ONLY, asla NEXT_PUBLIC_ değil.
# REST token (Authorization: FlespiToken <token>) for pulling device messages.
FLESPI_TOKEN=
# Secret guarding the flespi sync endpoint (/api/flespi/sync?secret=...).
# Set this on the external scheduler too. May reuse CRON_SECRET's value.
FLESPI_SYNC_SECRET=

# Basemap needs NO key: OpenFreeMap's hosted "liberty" vector style
# (see lib/map-tiles.ts), free for commercial use.

# ═══════════════════════════════════════════════════════════════════════════
# ÇOK-MÜŞTERİ AYARLARI (31.07.2026)
#
# TAMAMI İSTEĞE BAĞLIDIR. Hiçbiri tanımlı değilken uygulama HAK61'in bugünkü
# davranışını birebir üretir — HAK61 Vercel projesine bu bloktan tek satır bile
# eklenmez. scripts/check-tenant-defaults.mjs bunu her `npm run verify`'da
# denetler. Aşağıdaki yorumlarda köşeli parantez içindeki değer VARSAYILANDIR.
#
# İstemciye ulaşan her ayar NEXT_PUBLIC_ önekli olmak ZORUNDA: öneksiz env
# tarayıcıda undefined'dır ve ayar sessizce varsayılana döner.
# ═══════════════════════════════════════════════════════════════════════════

# ── MARKA ──────────────────────────────────────────────────────────────────
# Kayıt defteri lib/brand.ts'te. Bilinen kod: hak61 | sendigo.
# Yeni müşteri için görseller public/brands/<tenant>/ altına konur ve
# `npm run brand:assets -- <tenant>` ile türevleri üretilir.
NEXT_PUBLIC_TENANT=hak61                                    # [hak61]
# Aşağıdakiler künyeyi EZER; boş bırakılırsa kayıt defterindeki değer geçerli.
NEXT_PUBLIC_BRAND_NAME=                                     # [HAK61]
NEXT_PUBLIC_BRAND_LEGAL_NAME=                               # [HAK61 GmbH]
NEXT_PUBLIC_BRAND_CITY=                                     # [Wien]
NEXT_PUBLIC_BRAND_APP_TITLE=                                # [HAK61 — Schicht & KM]
NEXT_PUBLIC_BRAND_DESCRIPTION=                              # [Çalışan vardiya ve kilometre takip sistemi]
NEXT_PUBLIC_BRAND_SHORT_NAME=                               # [HAK61]
# Logonun en/boy oranı. HAK61 geniş wordmark (3.05), Sendigo kare amblem (1.02).
NEXT_PUBLIC_BRAND_LOGO_RATIO=                               # [3.05]
NEXT_PUBLIC_BRAND_THEME_COLOR=                              # [#0d0e10]
NEXT_PUBLIC_BRAND_BACKGROUND_COLOR=                         # [#0a0b0e]

# ── RESMÎ BELGE ANTETİ (PDF) — SUNUCU tarafı, NEXT_PUBLIC_ DEĞİL ──────────
# Avusturya'da resmî belgede firma adı + adres + sicil kimliği bulunur.
# COMPANY_REG_LINE serbest satırdır: UID'si olan firmada "UID-Nr.: ATU…",
# henüz olmayanda "FN …" yazılır. Etiket koda gömülü DEĞİLDİR.
COMPANY_NAME=                                               # [HAK61 GmbH]
COMPANY_ADDRESS=                                            # [Josef-Ganahl-Straße 4, 6850 Dornbirn, Österreich]
COMPANY_REG_LINE=                                           # [UID-Nr.: ATU79519228]
COMPANY_EXTRA_LINE=                                         # [] (ör. "Geschäftsführer: …")
PDF_BRAND_MARK=                                             # [HAK] PDF kapağındaki 2-4 harflik amblem

# ── KURULUM MODU ───────────────────────────────────────────────────────────
# Şoför paneli (/panel). Kapalıyken şoför girişi reddedilir ve takip tamamen
# araç ekseninde yürür. ⚠️ Kapalıyken SHIFT_AUTO_END 'off' OLAMAZ — vardiyayı
# kapatacak kimse kalmaz; lib/tenant.ts açılışta hata fırlatır.
NEXT_PUBLIC_DRIVER_PANEL_ENABLED=                           # [true]
# Paket sayacı (alınan / teslim / teslim edilemeyen). Kapalıyken kapanış formu,
# yönetici düzenleme alanları, tablo/CSV sütunları ve PDF kolonları görünmez.
# Veri modeli aynen durur; geçmiş kayıtlar okunabilir kalır.
NEXT_PUBLIC_PACKAGES_ENABLED=                               # [true]
# Lenkzeit uyarısı (VO (EG) 561/2006). 2,5 t altı sınır geçmeyen filoda hukuken
# gereksiz; HAK61'de alışkanlık olduğu için AÇIK bırakıldı.
NEXT_PUBLIC_LENKZEIT_WARNING_ENABLED=                       # [true]
# Güvenlik skoru kalibrasyonu. K sabiti HAK61 filosunun canlı medyanına göre
# seçildi; başka filoda mutlak anlam taşımaz.
NEXT_PUBLIC_SAFETY_SCORE_CALIBRATED=                        # [true]
# Panel varsayılan dili (çerezi olmayan ziyaretçi). tr | de
NEXT_PUBLIC_DEFAULT_LOCALE=                                 # [tr]
# Filo ETİKETLERİ. DB'deki kod adları (bordo/mavi) ve renk kimliği DEĞİŞMEZ.
NEXT_PUBLIC_FLEET_BORDO_LABEL=                              # [i18n: "Bordo Filo"]
NEXT_PUBLIC_FLEET_MAVI_LABEL=                               # [i18n: "Mavi Filo"]
# Modül bayrakları
NEXT_PUBLIC_FUEL_ENABLED=                                   # [false]
NEXT_PUBLIC_EXPENSE_ENABLED=                                # [false]
NEXT_PUBLIC_MAINTENANCE_ENABLED=                            # [false]
NEXT_PUBLIC_LEAVES_ENABLED=                                 # [true] ⚠️ migration 031 gerekli

# ── VARDİYA OTOMATI — yalnız sunucu ────────────────────────────────────────
# Başlangıç tetiği:
#   depot_entry    — depoya girip ≥3 dk kalınca (HAK61)
#   first_ignition — Viyana gününün ilk kontak açılışı (araçlar geceyi depoda
#                    geçiren filo; depo geofence'i hiç tetiklenmez)
SHIFT_START_TRIGGER=                                        # [depot_entry]
# Otomatik kapanış:
#   off        — vardiyayı yalnız personel kapatır (HAK61, 22.07.2026 kuralı)
#   depot_idle — kontak kapalı + araç DEPODA + eşik kadar hareketsiz → kapanır.
#                Depo şartı kritik: gün içi teslimat durakları vardiyayı kapatmaz.
SHIFT_AUTO_END=                                             # [off]
SHIFT_AUTO_END_IDLE_MIN=                                    # [30]
# Araç gün sonuna kadar depoya dönmezse vardiya SON HAREKET anında kapanır
# (gece boyu açık kalmaz). Yalnız depot_idle modunda geçerli.
SHIFT_AUTO_END_MIDNIGHT_FALLBACK=                           # [true]
# "Tüm zamanlar" aralığının tabanı — sistemin canlıya alındığı gün.
FLEET_EPOCH=                                                # [2026-06-01T00:00:00.000Z]
