NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SESSION_PASSWORD=at-least-32-characters-long-random-secret

# Secret guarding the cron endpoints (?secret=... or Bearer).
# Set this on the external scheduler too.
CRON_SECRET=

# flespi GPS gateway (Teltonika FMC003) — SERVER-ONLY, asla NEXT_PUBLIC_ değil.
# REST token (Authorization: FlespiToken <token>) for pulling device messages.
FLESPI_TOKEN=
# Secret guarding the flespi sync endpoint (/api/flespi/sync?secret=...).
# Set this on the external scheduler too. May reuse CRON_SECRET's value.
FLESPI_SYNC_SECRET=

# ── KİRACI SORGU UCU (/api/mobile/kiraci-sorgu) — SERVER-ONLY ─────────────
# Mobil giris akisi: kullanici telefon+PIN yazar, uygulama once galzura.com'daki
# YONLENDIRME SERVISINE sorar, o da her kiraciya tek tek bu ucu sorar (yayilma),
# kim taniyorsa oraya giris yapilir. Bu env o ucun kapisi.
#
#   tanimsiz  -> uc 503 "yapilandirilmadi" doner (FAIL-CLOSED, gurultulu).
#                Yeni kiracida BU DEGER UNUTULURSA o kiracinin personeli
#                hicbir yere yonlenemez — ama yonlendirme servisi 503'u gorur,
#                sessiz kalmaz.
#   acik      -> uc KIMLIKSIZ calisir. Volkan'in kabul ettigi acik uc; karar
#                env'e yazili olsun diye sentinel, sessiz varsayilan degil.
#   <sir>     -> Authorization: Bearer <sir> zorunlu. ONERILEN.
#
# ⚠️ CRON_SECRET DEGERI BURAYA KOPYALANMAZ: o sir /api/cron/saklama gibi VERI
# SILEN uclari da aciyor. Ayri deger uretin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Bu sir ISTEMCIYE HIC GIRMEZ — ucu telefon degil, yonlendirme servisi cagirir.
KIRACI_SORGU_SECRET=

# ── TAKOGRAF OKUYUCU SERVİSİ (migration 091) — SERVER-ONLY ─────────────────
# .ddd dosyasını ayrıştıran Go servisi. Hetzner/Almanya, 127.0.0.1:8790,
# dışarıya "galzura-fleet" adlı AYRI Cloudflare tüneliyle çıkar.
# ⚠️ Proofcan'ın tünelinden AYRIDIR — fleet galzura.com, Proofcan proofcan.com.
#
# 🔴 ANAHTARIN ADI TAM OLARAK BUDUR: TAKOGRAF_URL.
# `TAKOGRAF_SERVIS_URL` diye bir anahtar YOKTUR ve yanlış adla girilirse hata
# ÇIKMAZ — servisAyristir() hiç çağrılmaz, her .ddd arşive girer ama
# ayrıştırılmaz: faaliyet tablosu boş, zaman sütunları boş, mühür "denenmedi".
# Kodda tek okuyan yer: lib/takograf-servis.ts:33,51,114
#
# İKİSİ BİRDEN dolu olmalı — biri eksikse servisYapilandirildi() false döner.
# BOŞ BIRAKMAK GÜVENLİDİR: dosya yine Storage'a yazılır ve indirilebilir
# (arşiv sözü tutulur), yalnız ayrıştırma "bekliyor" kalır ve panelin
# "Yeniden oku" düğmesiyle sonradan tamamlanır.
TAKOGRAF_URL=                                               # ör. https://takograf.galzura.com
# Sunucuda üretilir (~/takograf/etc/takograf.env, chmod 600) ve dışarı çıkmaz.
# Vercel'e `Secret` tipinde girilir. Servis sır tanımsızsa her isteğe 401 döner.
TAKOGRAF_SECRET=

# Basemap needs NO key: OpenFreeMap's hosted "liberty" vector style
# (see lib/map-tiles.ts), free for commercial use.

# ═══════════════════════════════════════════════════════════════════════════
# ÇOK-MÜŞTERİ AYARLARI (31.07.2026)
#
# TAMAMI İSTEĞE BAĞLIDIR. Hiçbiri tanımlı değilken uygulama HAK61'in bugünkü
# davranışını birebir üretir — HAK61 Vercel projesine bu bloktan tek satır bile
# eklenmez. scripts/check-tenant-defaults.mjs bunu her `npm run verify`'da
# denetler. Aşağıdaki yorumlarda köşeli parantez içindeki değer VARSAYILANDIR.
#
# İstemciye ulaşan her ayar NEXT_PUBLIC_ önekli olmak ZORUNDA: öneksiz env
# tarayıcıda undefined'dır ve ayar sessizce varsayılana döner.
# ═══════════════════════════════════════════════════════════════════════════

# ── MARKA ──────────────────────────────────────────────────────────────────
# Kayıt defteri lib/brand.ts'te. Bilinen kod: hak61 | sendigo.
# Yeni müşteri için görseller public/brands/<tenant>/ altına konur ve
# `npm run brand:assets -- <tenant>` ile türevleri üretilir.
NEXT_PUBLIC_TENANT=hak61                                    # [hak61]
# Aşağıdakiler künyeyi EZER; boş bırakılırsa kayıt defterindeki değer geçerli.
NEXT_PUBLIC_BRAND_NAME=                                     # [HAK61]
NEXT_PUBLIC_BRAND_LEGAL_NAME=                               # [HAK61 GmbH]
NEXT_PUBLIC_BRAND_CITY=                                     # [Wien]
NEXT_PUBLIC_BRAND_APP_TITLE=                                # [HAK61 — Schicht & KM]
NEXT_PUBLIC_BRAND_DESCRIPTION=                              # [Çalışan vardiya ve kilometre takip sistemi]
NEXT_PUBLIC_BRAND_SHORT_NAME=                               # [HAK61]
# Logonun en/boy oranı. HAK61 geniş wordmark (3.05), Sendigo kare amblem (1.02).
NEXT_PUBLIC_BRAND_LOGO_RATIO=                               # [3.05]
NEXT_PUBLIC_BRAND_THEME_COLOR=                              # [#0d0e10]
NEXT_PUBLIC_BRAND_BACKGROUND_COLOR=                         # [#0a0b0e]

# ── RESMÎ BELGE ANTETİ (PDF) ──────────────────────────────────────────────
# Avusturya'da resmî belgede firma adı + adres + sicil kimliği bulunur.
# COMPANY_REG_LINE serbest satırdır: UID'si olan firmada "UID-Nr.: ATU…",
# henüz olmayanda "FN …" yazılır. Etiket koda gömülü DEĞİLDİR.
#
# ⚠️ NEXT_PUBLIC_ ÖNEKİ ZORUNLU (31.07.2026'da düzeltildi). PDF'ler TARAYICIDA
# üretilir (@react-pdf/renderer, 5 bileşenin beşi de "use client"); öneksiz env
# istemcide undefined'dır ve künye sessizce HAK61 varsayılanına düşer. Sendigo
# kabul testinde tam olarak bu oldu: indirilen AZG raporunda HAK61'in adı,
# adresi ve UID numarası basılıyordu.
# Öneksiz adlar geriye dönük OKUNMAYA DEVAM EDER (sunucu tarafı için).
NEXT_PUBLIC_COMPANY_NAME=                                   # [HAK61 GmbH]
NEXT_PUBLIC_COMPANY_ADDRESS=                                # [Josef-Ganahl-Straße 4, 6850 Dornbirn, Österreich]
NEXT_PUBLIC_COMPANY_REG_LINE=                               # [UID-Nr.: ATU79519228]
NEXT_PUBLIC_COMPANY_EXTRA_LINE=                             # [] (ör. "Geschäftsführer: …")
# PDF kapağındaki 2-4 harflik amblem. İNDİRİLEN DOSYA ADININ öneki de bundan
# türer: "SEN" → SEN_AZG_2026-07.pdf · sen-kraftstoff-….pdf
NEXT_PUBLIC_PDF_BRAND_MARK=                                 # [HAK]

# ── KURULUM MODU ───────────────────────────────────────────────────────────
# Şoför paneli (/panel). Kapalıyken şoför girişi reddedilir ve takip tamamen
# araç ekseninde yürür. ⚠️ Kapalıyken SHIFT_AUTO_END 'off' OLAMAZ — vardiyayı
# kapatacak kimse kalmaz; lib/tenant.ts açılışta hata fırlatır.
NEXT_PUBLIC_DRIVER_PANEL_ENABLED=                           # [true]
# Şoför vardiyayı hangi araçla açar?
#   assigned — atanmış aracıyla (HAK61). Ataması yoksa başlatamaz.
#   free     — plakayı vardiya açarken kendi seçer (araç↔şoför sabit ataması
#              olmayan filo; aynı araç gece/gündüz farklı şoförlerde).
#              Seçim yalnız o vardiya için geçerli, kalıcı atama yazılmaz.
NEXT_PUBLIC_DRIVER_VEHICLE_CHOICE=                          # [assigned]
# Bir şoför bir günde kaç vardiya açabilir. 'one' = günde tek vardiya (kapanan
# gün yeniden açılır, yeni satır yazılmaz). 'many' = aynı gün ikinci vardiya
# YENİ SATIR olarak açılır (Sendigo: gece vardiyası + gündüz çağrı işi) ve
# yönetici panosunda Dikkat kalemi olarak görünür. Otomatik vardiya motoru bu
# ayarı OKUMAZ — kontak kaynaklı çöp vardiya kilidi her iki modda da durur.
NEXT_PUBLIC_SHIFT_PER_DAY=                                  # [one]
# Yöneticinin üst çubuğunda "Şoför Paneli" geçişi. Yöneticisi aynı zamanda
# direksiyona geçen müşteride açılır. Şoför paneli kapalıysa zaten görünmez.
# ⚠️ Yalnız bağlantıyı gösterir; yönetici vardiyalarının şoför metriklerinden
# elenmesini (lib/driver-scope.ts) DEĞİŞTİRMEZ.
NEXT_PUBLIC_ADMIN_DRIVER_PANEL_LINK=                        # [false]
# Paket sayacı (alınan / teslim / teslim edilemeyen). Kapalıyken kapanış formu,
# yönetici düzenleme alanları, tablo/CSV sütunları ve PDF kolonları görünmez.
# Veri modeli aynen durur; geçmiş kayıtlar okunabilir kalır.
NEXT_PUBLIC_PACKAGES_ENABLED=                               # [true]
# Lenkzeit uyarısı (VO (EG) 561/2006). 2,5 t altı sınır geçmeyen filoda hukuken
# gereksiz; HAK61'de alışkanlık olduğu için AÇIK bırakıldı.
NEXT_PUBLIC_LENKZEIT_WARNING_ENABLED=                       # [true]
# Mesajlasma okundu bilgisi (mesaj basina ✓✓). Kapaliyken mesajlasma tam
# calisir ama okundu damgasi YAZILMAZ ve okunmamis sayaci duser (kaynagi ayni
# tablo). ⚠️ DACH: Avusturya §96(1)3 ArbVG / Almanya §87 BetrVG calisani
# izleyen teknik sistemler icin isyeri konseyi onayi istiyor; "07:14'te okudu"
# kaydi bu tanima girebilir. Betriebsvereinbarung yoksa false yapin.
NEXT_PUBLIC_READ_RECEIPTS_ENABLED=                          # [true]
# Güvenlik skoru kalibrasyonu. K sabiti HAK61 filosunun canlı medyanına göre
# seçildi; başka filoda mutlak anlam taşımaz.
NEXT_PUBLIC_SAFETY_SCORE_CALIBRATED=                        # [true]
# Panel varsayılan dili (çerezi olmayan ziyaretçi). tr | de
NEXT_PUBLIC_DEFAULT_LOCALE=                                 # [tr]
# KİRACININ SAAT DİLİMİ (IANA adı) — panelin VE mobil uygulamanın tek kaynağı.
# Tüm saatler, gün anahtarları ve "bugün/bu hafta/bu ay" pencereleri buradan
# çözülür; mobil uç aynı değeri /login ve /me yanıtında `tenant.saatDilimi`
# olarak alır. Türkiye müşterisi: Europe/Istanbul.
# ⚠️ Geçersiz IANA adı sunucu açılışında hata verir (assertTenantConfig).
NEXT_PUBLIC_TENANT_TZ=                                      # [Europe/Vienna]
# Filo ETİKETLERİ. DB'deki kod adları (bordo/mavi) ve renk kimliği DEĞİŞMEZ.
NEXT_PUBLIC_FLEET_BORDO_LABEL=                              # [i18n: "Bordo Filo"]
NEXT_PUBLIC_FLEET_MAVI_LABEL=                               # [i18n: "Mavi Filo"]
# KULLANILAN FİLOLAR — Araçlar sayfasındaki çipler ve araç formundaki seçenek.
# Tek filolu müşteride ikinci filo hep "0" gösteriyordu. Virgüllü liste;
# DB kod adları ve migration 023 CHECK kısıtı DEĞİŞMEZ, yalnız arayüz süzülür.
NEXT_PUBLIC_FLEETS=                                         # [bordo,mavi]
# Modül bayrakları
NEXT_PUBLIC_FUEL_ENABLED=                                   # [false]
NEXT_PUBLIC_EXPENSE_ENABLED=                                # [false]
NEXT_PUBLIC_MAINTENANCE_ENABLED=                            # [false]
NEXT_PUBLIC_LEAVES_ENABLED=                                 # [true] ⚠️ migration 031 gerekli

# ── MALİYET ORANLARI (€/km · €/paket) — yalnız sunucu ──────────────────────
# DÖRDÜ DE NEXT_PUBLIC_ DEĞİL, bilerek: oran sunucuda çarpılır, ekrana SONUÇ
# prop olarak iner. NEXT_PUBLIC_ yapılsaydı fiyat/ücret tarayıcı paketine
# gömülürdü — hem gereksiz hem de kaynak koddan okunabilir olurdu.
#
# ⚠️ ÜÇÜ VARSAYIM, BİRİ ÖLÇÜM. Rapor hangisinin env'den geldiğini ekranda
# söyler; girilmeyen oran "piyasa varsayımı" etiketiyle görünür. €/km bir
# KESTİRİMDİR, muhasebe kaydı değildir.
#
# 1) Yakıt litre fiyatı. Varsayılan = Avusturya geneli ortalama dizel pompa
#    fiyatı (WKO, 17.08.2026, MÖSt + USt dâhil). Filo kartıyla alan müşteri
#    kendi anlaşmalı fiyatını buraya yazar.
#    ⚠️ TEK KAYNAK: 23.08.2026'ya kadar ikinci bir sabit daha vardı
#    (lib/analytics-shared.ts DIESEL_EUR_PER_L = 1,65, env'siz) ve aynı litre
#    yakıt Analiz ekranında %24 farklı € basıyordu. O sabit silindi.
FUEL_PRICE_EUR_PER_L=                                       # [2.043]
#    ⚠️ 24.08.2026'DAN BERİ BU ORAN ARTIK ELLE GÜNCELLENMİYOR. Fiyat AB
#    Komisyonu Weekly Oil Bulletin'den günlük cron ile çekilip
#    `fuel_price_reference` tablosuna yazılıyor (migration 077). Bu env
#    ve yukarıdaki varsayılan artık YALNIZ YEDEK: referans yoksa, çok
#    bayatladıysa ya da migration 077 çalıştırılmadıysa devreye girer.
#    Zincir: panel > referans(taze) > referans(bayat) > bu env > varsayılan.
# Referansın hangi ülkeden okunacağı. Boşsa kiracı ülkesi
# (NEXT_PUBLIC_TENANT_DEFAULT_COUNTRY) kullanılır. Bugün yalnız AT ve DE için
# referans üretiliyor; başka bir kod yazmak hata vermez, zincir env'e düşer.
FUEL_PRICE_COUNTRY=                                         # [AT]
# 2) Filo ortalama tüketimi (L/100km) — YEDEK/GEÇERSİZ KILMA.
#    NORMALDE BOŞ BIRAKIN: rapor tüketimi filonun KENDİ telemetrisinden ölçer.
#    Burası doldurulursa ölçüm geçersiz kılınır. Varsayılan yalnız ölçüm hiç
#    yapılamadığında devreye girer (HAK61 ölçümü 23.08.2026: 22 araç, 30 gün).
FLEET_L_PER_100KM=                                          # [11.74]
# 3) İşçilik (€ / şoför-saati) — İŞVEREN TOPLAM MALİYETİ, brüt ücret değil.
#    Varsayılan türetimi: WKO KV Güterbeförderungsgewerbe 1.1.2026, Lohngruppe 2
#    (≤5 yıl) 2.178,07 €/ay ÷ 173 = 12,59 €/sa brüt × 1,167 (13./14. maaş)
#    × 1,30 (Lohnnebenkosten) ≈ 19,10 €/sa. Bir MERTEBE tahminidir; kıdem,
#    fazla mesai zammı ve gerçek Lohngruppe müşteriye göre değişir.
LABOR_EUR_PER_HOUR=                                         # [19.1]
# 4) Araç sabit gideri (€ / ÇALIŞILAN araç-günü) — leasing + sigorta + servis
#    + vergi. Payda TAKVİM GÜNÜ DEĞİL, o gün en az bir vardiya görmüş (araç,
#    gün) çiftidir. Varsayılan türetimi: ~750 €/ay ÷ ~15 çalışılan gün ≈ 50 €.
#    ⚠️ Oranların EN OYNAĞI: sahip olunan (leasing'siz) filoda çok daha düşük.
VEHICLE_EUR_PER_DAY=                                        # [50]

# ── VARDİYA OTOMATI — yalnız sunucu ────────────────────────────────────────
# Başlangıç tetiği:
#   depot_entry    — depoya girip ≥3 dk kalınca (HAK61)
#   first_ignition — Viyana gününün ilk kontak açılışı (araçlar geceyi depoda
#                    geçiren filo; depo geofence'i hiç tetiklenmez)
#   off            — otomatik başlatma YOK; vardiyayı yalnız insan açar (şoför
#                    paneli ya da yönetici "adına başlat"). Aracı birden çok
#                    şoförün paylaştığı filo için: motor araç ekseninde ve
#                    ATANMIŞ şoföre açtığı için orada yanlış kişiye yazardı.
SHIFT_START_TRIGGER=                                        # [depot_entry]
# Otomatik kapanış:
#   off        — vardiyayı yalnız personel kapatır (HAK61, 22.07.2026 kuralı)
#   depot_idle — kontak kapalı + araç DEPODA + eşik kadar hareketsiz → kapanır.
#                Depo şartı kritik: gün içi teslimat durakları vardiyayı kapatmaz.
SHIFT_AUTO_END=                                             # [off]
SHIFT_AUTO_END_IDLE_MIN=                                    # [30]
# Araç gün sonuna kadar depoya dönmezse vardiya SON HAREKET anında kapanır
# (gece boyu açık kalmaz). Yalnız depot_idle modunda geçerli.
SHIFT_AUTO_END_MIDNIGHT_FALLBACK=                           # [true]
# "Tüm zamanlar" aralığının tabanı — sistemin canlıya alındığı gün.
FLEET_EPOCH=                                                # [2026-06-01T00:00:00.000Z]

# ── GÜVENLİK KATMANI (migration 045) ───────────────────────────────────────
# DÖRDÜ DE VARSAYILAN OLARAK BUGÜNKÜ DAVRANIŞ. Boş bırakıldığında HAK61 ve
# Sendigo'da hiçbir şey değişmez: giriş oturumu yazılmaz, eylem izi tutulmaz,
# CSV açık kalır, filigran basılmaz. Katman migration 045'i gerektiriyor —
# bayrağı açmadan önce db/migrations/045_owner_security.sql çalıştırılmalı.
#
# Ana şalter (sunucu): giriş oturumu kaydı + eylem izi + oturum sürümü denetimi
# + /admin/guvenlik ekranı. Patron kademesi ayrıca DB'de atanır:
#   update public.workers set is_owner = true where phone = '+43…';
SECURITY_LAYER_ENABLED=                                     # [false]
# ⚠️ AYNI ŞALTERİN İSTEMCİ AYNASI — ikisi BİRLİKTE açılmalı.
# PDF ve CSV tarayıcıda üretiliyor, yani "indirdi" izini yazacak çağrı
# istemciden gidiyor ve yukarıdaki sunucu-özel bayrağı okuyamaz. Bunu açık
# bırakmak zararsız (son sözü sunucu söyler), kapalı bırakmak yalnız
# dışa aktarma izini sessizce eksiltir. scripts/check-demo-env.mjs denetler.
NEXT_PUBLIC_SECURITY_LAYER_ENABLED=                         # [false]
# Tek oturum kilidi: her yeni giriş öncekini düşürür (web çerezi VE mobil
# token birlikte). HAK61'de KAPALI olmalı — şoför hem telefondan hem depodaki
# tabletten girebiliyor ve bu bugünkü davranış.
SINGLE_SESSION=                                             # [false]
# CSV dışa aktarma. false → dört butonun dördü gizlenir VE sunucu tarafındaki
# bordro CSV kaynağı reddeder (yalnız butonu gizlemek yetmez).
NEXT_PUBLIC_EXPORT_ENABLED=                                 # [true]
# PDF filigranı. Boş = filigran YOK. Dolu verilirse rapor sayfalarına çapraz
# olarak "<metin> — <kullanıcı adı> — <tarih saat>" basılır.
NEXT_PUBLIC_PDF_WATERMARK=                                  # [] (ör. GALZURA DEMO)

# ── ERİŞİM KAPILARI (migration 046) ────────────────────────────────────────
# TEK ŞALTER, DÖRT KAPI: cihaz onayı, ülke onayı, saat kilidi, ölü adam
# anahtarı. Boş bırakıldığında HAK61 ve Sendigo'da hiçbir şey değişmez —
# giriş akışı bugünküyle birebir aynı kalır ve tek sorgu bile atılmaz.
#
# ⚠️ ÖNCE db/migrations/046_access_gates.sql (ve onun gerektirdiği 045)
#    çalıştırılmalı. Migration olmadan açılırsa kapılar eksik-tablo dalına
#    düşer ve GİRİŞİ ENGELLEMEZ — ama katman da fiilen çalışmaz.
#
# Patron (workers.is_owner) DÖRDÜNDEN DE muaftır: aksi hâlde kendi kurduğu
# kapının arkasında kalır ve onaylayacak kimse olmaz.
ACCESS_GATES_ENABLED=                                       # [false]
# Onay beklemeden serbest ülkeler (ISO 3166-1 alpha-2, virgülle). Kişi bazında
# workers.allowed_countries bunu ezer. Ülke Vercel'in x-vercel-ip-country
# başlığından okunur; başlık yoksa (yerel geliştirme) kapı denetlenmez.
ACCESS_COUNTRIES=                                           # [TR,AT]
# Giriş serbest saat aralığı — Europe/ISTANBUL (panelin geri kalanı Viyana!).
# 07:00-21:00 İstanbul = 06:00-20:00 Viyana. Kişi bazında
# workers.access_hours_start/end bunu ezer; başlangıç > bitiş ise aralık
# gece yarısını sarar (22:00-06:00 geçerli bir aralıktır).
ACCESS_HOURS_START=                                         # [07:00]
ACCESS_HOURS_END=                                           # [21:00]
